        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#14213D"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI",
            "alignment": "left"
          }
        ]
      }
    },
    "page": {
